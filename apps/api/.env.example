# Application
NODE_ENV=development
PORT=3001

# PostgreSQL (local Docker Compose)
DATABASE_URL=postgresql://workboard:workboard@localhost:5432/work_board?schema=public
TEST_DATABASE_URL=postgresql://workboard:workboard@localhost:5432/work_board_test?schema=public

# Redis (local Docker Compose)
REDIS_URL=redis://localhost:6379

# Cache
CACHE_TTL_SECONDS=60

# CORS — browser origin allowed to call the API
CORS_ORIGIN=http://localhost:3000

# In Progress capacity. Positive integer. Docker is not required for the board.
BOARD_WIP_LIMIT=2

